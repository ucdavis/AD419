{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "3063510071914971109"
    }
  },
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "ad419",
      "metadata": {
        "description": "Base name used for resources."
      }
    },
    "env": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "test",
        "prod"
      ],
      "metadata": {
        "description": "Deployment environment name."
      }
    },
    "expectedSubscriptionId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Expected Azure subscription ID for non-dev deployments. Required for test and prod deployments."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "sqlAdminLogin": {
      "type": "string",
      "metadata": {
        "description": "SQL admin login for SQL authentication."
      }
    },
    "sqlAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "SQL admin password for SQL authentication."
      }
    },
    "sqlDatabaseName": {
      "type": "string",
      "defaultValue": "[parameters('appName')]",
      "metadata": {
        "description": "Application SQL database name."
      }
    },
    "dataSqlDatabaseName": {
      "type": "string",
      "defaultValue": "[format('{0}-data', parameters('appName'))]",
      "metadata": {
        "description": "Data SQL database name."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Additional resource tags to apply."
      }
    },
    "appInsightsRetentionInDays": {
      "type": "int",
      "defaultValue": 30,
      "minValue": 30,
      "maxValue": 730,
      "metadata": {
        "description": "Application Insights retention in days."
      }
    },
    "notificationBaseUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional notification base URL. Defaults to the App Service hostname."
      }
    }
  },
  "variables": {
    "appNameSafe": "[toLower(replace(replace(parameters('appName'), ' ', ''), '_', ''))]",
    "nameToken": "[substring(uniqueString(resourceGroup().id, parameters('appName'), parameters('env')), 0, 6)]",
    "expectedResourceGroupSuffix": "[format('-{0}', parameters('env'))]",
    "normalizedExpectedSubscriptionId": "[toLower(parameters('expectedSubscriptionId'))]",
    "normalizedCurrentSubscriptionId": "[toLower(subscription().subscriptionId)]",
    "deploymentGuardPassed": "[or(equals(parameters('env'), 'dev'), and(and(not(empty(parameters('expectedSubscriptionId'))), equals(variables('normalizedCurrentSubscriptionId'), variables('normalizedExpectedSubscriptionId'))), endsWith(resourceGroup().name, variables('expectedResourceGroupSuffix'))))]",
    "sqlServerName": "[toLower(format('sql-{0}-{1}-{2}', variables('appNameSafe'), parameters('env'), variables('nameToken')))]",
    "webPlanName": "[toLower(format('asp-{0}-{1}-{2}', variables('appNameSafe'), parameters('env'), variables('nameToken')))]",
    "webAppName": "[toLower(format('web-{0}-{1}-{2}', variables('appNameSafe'), parameters('env'), variables('nameToken')))]",
    "appInsightsName": "[toLower(format('appi-{0}-{1}-{2}', variables('appNameSafe'), parameters('env'), variables('nameToken')))]",
    "logAnalyticsWorkspaceName": "[toLower(format('log-{0}-{1}-{2}', variables('appNameSafe'), parameters('env'), variables('nameToken')))]",
    "sqlSkuName": "[if(equals(parameters('env'), 'prod'), 'S0', 'Basic')]",
    "sqlSkuTier": "[if(equals(parameters('env'), 'prod'), 'Standard', 'Basic')]",
    "webSkuName": "[if(equals(parameters('env'), 'prod'), 'B1', 'B1')]",
    "webSkuTier": "[if(equals(parameters('env'), 'prod'), 'Basic', 'Basic')]",
    "resourceTags": "[union(parameters('tags'), createObject('environment', parameters('env'), 'application', parameters('appName')))]",
    "sqlServerHostnameSuffix": "[environment().suffixes.sqlServerHostname]",
    "sqlServerFqdn": "[format('{0}{1}{2}', variables('sqlServerName'), if(startsWith(variables('sqlServerHostnameSuffix'), '.'), '', '.'), variables('sqlServerHostnameSuffix'))]",
    "sqlConnectionString": "[format('Server=tcp:{0},1433;Initial Catalog={1};Persist Security Info=False;User ID={2};Password={3};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;', variables('sqlServerFqdn'), parameters('sqlDatabaseName'), parameters('sqlAdminLogin'), parameters('sqlAdminPassword'))]",
    "dataSqlConnectionString": "[format('Server=tcp:{0},1433;Initial Catalog={1};Persist Security Info=False;User ID={2};Password={3};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;', variables('sqlServerFqdn'), parameters('dataSqlDatabaseName'), parameters('sqlAdminLogin'), parameters('sqlAdminPassword'))]"
  },
  "resources": [
    {
      "condition": "[variables('deploymentGuardPassed')]",
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logAnalyticsWorkspaceName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('resourceTags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": "[parameters('appInsightsRetentionInDays')]"
      }
    },
    {
      "condition": "[variables('deploymentGuardPassed')]",
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "tags": "[variables('resourceTags')]",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]"
      ]
    },
    {
      "condition": "[variables('deploymentGuardPassed')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "sql",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[variables('sqlServerName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[variables('resourceTags')]"
          },
          "adminLogin": {
            "value": "[parameters('sqlAdminLogin')]"
          },
          "adminPassword": {
            "value": "[parameters('sqlAdminPassword')]"
          },
          "appDatabaseName": {
            "value": "[parameters('sqlDatabaseName')]"
          },
          "dataDatabaseName": {
            "value": "[parameters('dataSqlDatabaseName')]"
          },
          "skuName": {
            "value": "[variables('sqlSkuName')]"
          },
          "skuTier": {
            "value": "[variables('sqlSkuTier')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.41.2.15936",
              "templateHash": "12215806794789433436"
            }
          },
          "parameters": {
            "name": {
              "type": "string",
              "metadata": {
                "description": "SQL server name."
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region for SQL resources."
              }
            },
            "tags": {
              "type": "object",
              "metadata": {
                "description": "Tags to apply to SQL resources."
              }
            },
            "adminLogin": {
              "type": "string",
              "metadata": {
                "description": "SQL admin login for SQL authentication."
              }
            },
            "adminPassword": {
              "type": "securestring",
              "metadata": {
                "description": "SQL admin password for SQL authentication."
              }
            },
            "appDatabaseName": {
              "type": "string",
              "metadata": {
                "description": "Application SQL database name."
              }
            },
            "dataDatabaseName": {
              "type": "string",
              "metadata": {
                "description": "Data SQL database name."
              }
            },
            "skuName": {
              "type": "string",
              "defaultValue": "S0",
              "metadata": {
                "description": "SQL database SKU name."
              }
            },
            "skuTier": {
              "type": "string",
              "defaultValue": "Standard",
              "metadata": {
                "description": "SQL database SKU tier."
              }
            },
            "allowAzureServices": {
              "type": "bool",
              "defaultValue": true,
              "metadata": {
                "description": "Whether to allow Azure services/resources to access this SQL server."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Sql/servers",
              "apiVersion": "2023-08-01",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "administratorLogin": "[parameters('adminLogin')]",
                "administratorLoginPassword": "[parameters('adminPassword')]",
                "minimalTlsVersion": "1.2",
                "publicNetworkAccess": "Enabled"
              }
            },
            {
              "condition": "[parameters('allowAzureServices')]",
              "type": "Microsoft.Sql/servers/firewallRules",
              "apiVersion": "2023-08-01",
              "name": "[format('{0}/{1}', parameters('name'), 'AllowAzureServices')]",
              "properties": {
                "startIpAddress": "0.0.0.0",
                "endIpAddress": "0.0.0.0"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Sql/servers', parameters('name'))]"
              ]
            },
            {
              "type": "Microsoft.Sql/servers/databases",
              "apiVersion": "2023-08-01",
              "name": "[format('{0}/{1}', parameters('name'), parameters('appDatabaseName'))]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "[parameters('skuName')]",
                "tier": "[parameters('skuTier')]"
              },
              "properties": {
                "collation": "SQL_Latin1_General_CP1_CI_AS"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Sql/servers', parameters('name'))]"
              ]
            },
            {
              "type": "Microsoft.Sql/servers/databases",
              "apiVersion": "2023-08-01",
              "name": "[format('{0}/{1}', parameters('name'), parameters('dataDatabaseName'))]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "[parameters('skuName')]",
                "tier": "[parameters('skuTier')]"
              },
              "properties": {
                "collation": "SQL_Latin1_General_CP1_CI_AS"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Sql/servers', parameters('name'))]"
              ]
            }
          ],
          "outputs": {
            "appDatabaseName": {
              "type": "string",
              "value": "[parameters('appDatabaseName')]"
            },
            "dataDatabaseName": {
              "type": "string",
              "value": "[parameters('dataDatabaseName')]"
            },
            "serverName": {
              "type": "string",
              "value": "[parameters('name')]"
            }
          }
        }
      }
    },
    {
      "condition": "[variables('deploymentGuardPassed')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "compute",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[variables('resourceTags')]"
          },
          "webPlanName": {
            "value": "[variables('webPlanName')]"
          },
          "webAppName": {
            "value": "[variables('webAppName')]"
          },
          "webSkuName": {
            "value": "[variables('webSkuName')]"
          },
          "webSkuTier": {
            "value": "[variables('webSkuTier')]"
          },
          "sqlConnectionString": {
            "value": "[variables('sqlConnectionString')]"
          },
          "dataSqlConnectionString": {
            "value": "[variables('dataSqlConnectionString')]"
          },
          "environmentName": {
            "value": "[parameters('env')]"
          },
          "appInsightsConnectionString": {
            "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]"
          },
          "appInsightsInstrumentationKey": {
            "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').InstrumentationKey]"
          },
          "notificationBaseUrl": "[if(empty(parameters('notificationBaseUrl')), createObject('value', format('https://{0}.azurewebsites.net', variables('webAppName'))), createObject('value', parameters('notificationBaseUrl')))]"
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.41.2.15936",
              "templateHash": "104107724659722524"
            }
          },
          "parameters": {
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region for compute resources."
              }
            },
            "tags": {
              "type": "object",
              "metadata": {
                "description": "Tags to apply to compute resources."
              }
            },
            "webPlanName": {
              "type": "string",
              "metadata": {
                "description": "App Service plan name for the web app."
              }
            },
            "webAppName": {
              "type": "string",
              "metadata": {
                "description": "Web App name for the web app."
              }
            },
            "webSkuName": {
              "type": "string",
              "defaultValue": "B1",
              "metadata": {
                "description": "App Service plan SKU name."
              }
            },
            "webSkuTier": {
              "type": "string",
              "defaultValue": "Basic",
              "metadata": {
                "description": "App Service plan SKU tier."
              }
            },
            "linuxFxVersion": {
              "type": "string",
              "defaultValue": "DOTNETCORE|10.0",
              "metadata": {
                "description": "Linux App Service runtime stack."
              }
            },
            "sqlConnectionString": {
              "type": "securestring",
              "metadata": {
                "description": "SQL connection string."
              }
            },
            "dataSqlConnectionString": {
              "type": "securestring",
              "metadata": {
                "description": "Data SQL database connection string."
              }
            },
            "environmentName": {
              "type": "string",
              "metadata": {
                "description": "Environment name for app settings."
              }
            },
            "appInsightsConnectionString": {
              "type": "string",
              "metadata": {
                "description": "Application Insights connection string."
              }
            },
            "appInsightsInstrumentationKey": {
              "type": "string",
              "metadata": {
                "description": "Application Insights instrumentation key."
              }
            },
            "notificationBaseUrl": {
              "type": "string",
              "metadata": {
                "description": "Base URL used in generated notification emails."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Web/serverfarms",
              "apiVersion": "2023-12-01",
              "name": "[parameters('webPlanName')]",
              "location": "[parameters('location')]",
              "kind": "linux",
              "sku": {
                "name": "[parameters('webSkuName')]",
                "tier": "[parameters('webSkuTier')]",
                "size": "[parameters('webSkuName')]",
                "capacity": 1
              },
              "tags": "[parameters('tags')]",
              "properties": {
                "reserved": true
              }
            },
            {
              "type": "Microsoft.Web/sites",
              "apiVersion": "2023-12-01",
              "name": "[parameters('webAppName')]",
              "location": "[parameters('location')]",
              "kind": "app,linux",
              "identity": {
                "type": "SystemAssigned"
              },
              "tags": "[parameters('tags')]",
              "properties": {
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('webPlanName'))]",
                "httpsOnly": true,
                "siteConfig": {
                  "alwaysOn": true,
                  "ftpsState": "FtpsOnly",
                  "healthCheckPath": "/health",
                  "http20Enabled": true,
                  "linuxFxVersion": "[parameters('linuxFxVersion')]",
                  "minTlsVersion": "1.2",
                  "appSettings": [
                    {
                      "name": "ASPNETCORE_ENVIRONMENT",
                      "value": "[parameters('environmentName')]"
                    },
                    {
                      "name": "DB_CONNECTION",
                      "value": "[parameters('sqlConnectionString')]"
                    },
                    {
                      "name": "DATA_DB_CONNECTION",
                      "value": "[parameters('dataSqlConnectionString')]"
                    },
                    {
                      "name": "Notification__BaseUrl",
                      "value": "[parameters('notificationBaseUrl')]"
                    },
                    {
                      "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                      "value": "[parameters('appInsightsConnectionString')]"
                    },
                    {
                      "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
                      "value": "[parameters('appInsightsInstrumentationKey')]"
                    },
                    {
                      "name": "APPLICATIONINSIGHTS_AGENT_EXTENSION_VERSION",
                      "value": "~3"
                    },
                    {
                      "name": "WEBSITE_RUN_FROM_PACKAGE",
                      "value": "1"
                    }
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Web/serverfarms', parameters('webPlanName'))]"
              ]
            }
          ],
          "outputs": {
            "defaultHostName": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-12-01').defaultHostName]"
            },
            "principalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-12-01', 'full').identity.principalId]"
            },
            "webAppName": {
              "type": "string",
              "value": "[parameters('webAppName')]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]",
        "[resourceId('Microsoft.Resources/deployments', 'sql')]"
      ]
    }
  ],
  "outputs": {
    "appServiceDefaultHostName": {
      "type": "string",
      "value": "[if(variables('deploymentGuardPassed'), reference(resourceId('Microsoft.Resources/deployments', 'compute'), '2025-04-01').outputs.defaultHostName.value, '')]"
    },
    "appServicePrincipalId": {
      "type": "string",
      "value": "[if(variables('deploymentGuardPassed'), reference(resourceId('Microsoft.Resources/deployments', 'compute'), '2025-04-01').outputs.principalId.value, '')]"
    },
    "appInsightsName": {
      "type": "string",
      "value": "[if(variables('deploymentGuardPassed'), variables('appInsightsName'), '')]"
    },
    "appInsightsConnectionString": {
      "type": "string",
      "value": "[if(variables('deploymentGuardPassed'), reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString, '')]"
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "value": "[if(variables('deploymentGuardPassed'), variables('logAnalyticsWorkspaceName'), '')]"
    },
    "sqlDatabaseName": {
      "type": "string",
      "value": "[parameters('sqlDatabaseName')]"
    },
    "dataSqlDatabaseName": {
      "type": "string",
      "value": "[parameters('dataSqlDatabaseName')]"
    },
    "sqlServerName": {
      "type": "string",
      "value": "[if(variables('deploymentGuardPassed'), reference(resourceId('Microsoft.Resources/deployments', 'sql'), '2025-04-01').outputs.serverName.value, '')]"
    },
    "webAppName": {
      "type": "string",
      "value": "[if(variables('deploymentGuardPassed'), reference(resourceId('Microsoft.Resources/deployments', 'compute'), '2025-04-01').outputs.webAppName.value, '')]"
    },
    "deploymentGuardPassed": {
      "type": "bool",
      "value": "[variables('deploymentGuardPassed')]"
    }
  }
}
